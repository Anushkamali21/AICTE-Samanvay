# AICTE SAMANVAY Environment Configuration

# Server Port
PORT=5000

# Client Application URL
CLIENT_URL=http://localhost:5173

# MongoDB Connection URI (Local or MongoDB Atlas)
# Leave as default or configure your MongoDB cluster URI.
# If MongoDB is unreachable, the system automatically runs in local demonstration mode.
MONGODB_URI=mongodb://127.0.0.1:27017/aicte_samanvay

# JWT Secret for Signing Authentication Tokens
JWT_SECRET=samanvay_aicte_production_secure_token_secret_2026

# Production External Gateways (Optional: Operates in Demo Mode when unconfigured)
OTP_PROVIDER_API_KEY=
SMS_GATEWAY_URL=
EMAIL_PROVIDER_API_KEY=
SMTP_HOST=
SMTP_PORT=
